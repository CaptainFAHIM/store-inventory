@model IEnumerable<BLL.DTOs.CategoryDTO>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Categories</h1>
        <p class="text-muted mb-0">Organize your product catalog by category.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Category</a>
</div>

<div class="inventory-panel p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 inventory-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">No categories found.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>