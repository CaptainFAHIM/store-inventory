@model BLL.DTOs.CategoryDTO

@{
    ViewData["Title"] = "Delete Category";
}

<div class="form-shell">
    <div class="form-card form-card-danger">
        <h1 class="h3 mb-2">Delete Category</h1>
        <p class="text-muted mb-4">You can only delete a category if no products are using it.</p>

        <div class="mb-4">
            <div class="text-uppercase text-muted small">Category Name</div>
            <div class="fs-4 fw-semibold">@Model.Name</div>
        </div>

        <form method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="d-flex gap-2">
                <button type="submit" name="decision" value="Yes" class="btn btn-danger">Delete</button>
                <button type="submit" name="decision" value="No" class="btn btn-outline-secondary">Cancel</button>
            </div>
        </form>
    </div>
</div>