@model BLL.DTOs.CategoryDTO

@{
    ViewData["Title"] = "Add Category";
}

<div class="form-shell">
    <div class="form-card">
        <h1 class="h3 mb-2">Add Category</h1>
        <p class="text-muted mb-4">Create a category to keep the inventory organized.</p>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control form-control-lg" placeholder="Example: Electronics" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Category</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}