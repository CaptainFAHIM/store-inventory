@model PurchaseOrderDTO

@{
    ViewData["Title"] = "New Purchase Order";
}

<div class="form-shell">
    <div class="form-card">
        <h1 class="h3 mb-2">New Purchase Order</h1>
        <p class="text-muted mb-4">Add a supplier and product line. Stock increases only when the order is received.</p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="SupplierName" class="form-label"></label>
                <input asp-for="SupplierName" class="form-control form-control-lg" />
                <span asp-validation-for="SupplierName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ProductId" class="form-label"></label>
                <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select form-select-lg">
                    <option value="">-- Select product --</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Qty" class="form-label"></label>
                    <input asp-for="Qty" class="form-control form-control-lg" />
                    <span asp-validation-for="Qty" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UnitCost" class="form-label"></label>
                    <input asp-for="UnitCost" class="form-control form-control-lg" />
                    <span asp-validation-for="UnitCost" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control form-control-lg" rows="4" placeholder="Optional note for the order"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Purchase Order</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}