@model BLL.DTOs.ProductDTO

@{
    ViewData["Title"] = "Delete Product";
}

<div class="form-shell">
    <div class="form-card form-card-danger">
        <h1 class="h3 mb-2">Delete Product</h1>
        <p class="text-muted mb-4">This action will permanently remove the product from inventory.</p>

        <div class="mb-4">
            <div class="text-uppercase text-muted small">Product Name</div>
            <div class="fs-4 fw-semibold">@Model.Name</div>
            <div class="text-muted mt-2">Category: @(Model.CategoryName ?? "-")</div>
            <div>Price: @Model.Price</div>
            <div>Quantity: @Model.Qty</div>
        </div>

        <form method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="d-flex gap-2">
                <button type="submit" name="Decision" value="Yes" class="btn btn-danger">Delete</button>
                <button type="submit" name="Decision" value="No" class="btn btn-outline-secondary">Cancel</button>
            </div>
        </form>
    </div>
</div>
