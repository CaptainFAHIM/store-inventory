@model BLL.DTOs.ProductDTO

@{
}

<h1>Are you sure to Delete?</h1>
<div class="mb-3">
    <h4 class="mb-1">@Model.Name</h4>
    <div class="text-muted">Category: @(Model.CategoryName ?? "-")</div>
    <div>Price: @Model.Price</div>
    <div>Quantity: @Model.Qty</div>
</div>
<form method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="submit" name="Decision" value="Yes" class="btn btn-danger" />
    <input type="submit" name="Decision" value="No" class="btn btn-primary" />
</form>
