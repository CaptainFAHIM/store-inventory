@model BLL.DTOs.ProductDTO

@{
    ViewData["Title"] = "Add Product";
}

<div class="form-shell">
    <div class="form-card">
        <h1 class="h3 mb-2">Add Product</h1>
        <p class="text-muted mb-4">Enter the product details and choose a category from SQL Server.</p>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control form-control-lg" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control form-control-lg" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Qty" class="form-label"></label>
                <input asp-for="Qty" class="form-control form-control-lg" />
                <span asp-validation-for="Qty" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Cid" class="form-label"></label>
                <select asp-for="Cid" asp-items="ViewBag.Categories" class="form-select form-select-lg">
                    <option value="">-- Select category --</option>
                </select>
                <span asp-validation-for="Cid" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Product</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
