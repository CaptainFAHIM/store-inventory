@model IEnumerable<BLL.DTOs.ProductDTO>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Inventory Products</h1>
        <p class="text-muted mb-0">Add, edit, delete, and search products stored in SQL Server.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Product</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-12 col-md-6 col-lg-4">
        <input name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by product name" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Qty</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@(item.CategoryName ?? "-")</td>
                    <td>@item.Price</td>
                    <td>@item.Qty</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">No products found.</td>
            </tr>
        }
        </tbody>
    </table>
</div>
