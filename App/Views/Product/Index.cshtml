@model IEnumerable<BLL.DTOs.ProductDTO>

@{
    ViewData["Title"] = "Products";
}

<div class="hero-card mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <div class="eyebrow">Inventory Dashboard</div>
            <h1 class="display-6 mb-2">Manage products fast, clean, and without clutter.</h1>
            <p class="lead mb-0">Create products, search by name, and keep category data organized in SQL Server.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Category" asp-action="Index" class="btn btn-outline-light">Categories</a>
            <a asp-action="Create" class="btn btn-light text-primary fw-semibold">Add Product</a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Products</div>
            <div class="stat-value">@ViewBag.TotalProducts</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card accent">
            <div class="stat-label">Categories</div>
            <div class="stat-value">@ViewBag.TotalCategories</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card warm">
            <div class="stat-label">Low Stock</div>
            <div class="stat-value">@ViewBag.LowStockProducts</div>
        </div>
    </div>
</div>

<div class="inventory-panel p-4 mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-7 col-lg-5">
            <input name="searchTerm" value="@ViewBag.SearchTerm" class="form-control form-control-lg" placeholder="Search by product name" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-lg">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Clear</a>
        </div>
    </form>
</div>

<div class="inventory-panel p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 inventory-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><div class="fw-semibold">@item.Name</div></td>
                        <td><span class="badge rounded-pill text-bg-secondary">@(item.CategoryName ?? "-")</span></td>
                        <td>@item.Price</td>
                        <td>
                            <div class="qty-control">
                                <form asp-action="DecreaseQty" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="qty-btn" aria-label="Decrease quantity">−</button>
                                </form>
                                <span class="qty-value">@item.Qty</span>
                                <form asp-action="IncreaseQty" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="qty-btn" aria-label="Increase quantity">+</button>
                                </form>
                            </div>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state py-5 text-center">
                            <h3 class="h4 mb-2">No products found</h3>
                            <p class="text-muted mb-3">Start by adding a product or clear the search filter.</p>
                            <a asp-action="Create" class="btn btn-primary">Add Your First Product</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
